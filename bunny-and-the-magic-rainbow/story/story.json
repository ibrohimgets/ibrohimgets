    { "id": "s1_title",   "t": 0.7,   "who": "narrator", "text": "Bunny and the Magic Rainbow!" },
    { "id": "s1_intro",   "t": 4.0,   "who": "narrator", "text": "In the Colorful Forest, a little bunny named Bobo wakes up." },
    { "id": "s1_morning", "t": 8.4,   "who": "bobo",     "text": "Good morning, sun! Good morning, rainbow!" },
    { "id": "s1_ohno",    "t": 14.3,  "who": "bobo",     "text": "Oh no! The rainbow lost its colors!" },
    { "id": "s1_find",    "t": 17.3,  "who": "bobo",     "text": "I will find them!" },

    { "id": "s2_wait",    "t": 20.9,  "who": "mimi",     "text": "Bobo! Wait for me!" },
