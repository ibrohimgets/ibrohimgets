{
  "name": "bunny-and-the-magic-rainbow",
  "version": "1.0.0",
  "private": true,
  "description": "A 2-minute animated cartoon for children aged 4-5, drawn with HTML5 Canvas.",
  "type": "module",
  "scripts": {
